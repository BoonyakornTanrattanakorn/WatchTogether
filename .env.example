# Copy to .env. Real environment variables take precedence over this file.
# .env is gitignored; .env.example is not, so keep real paths and secrets out
# of this file.

# --- the one you have to set -------------------------------------------------

# Where your video files are. Needed when starting with `npm start`, which
# has no convenient way to pass a path; a path given on the command line
# overrides it.
#
# Separate several roots with ';' or ':' — both work on every platform.
# Use forward slashes on Windows too. Quote nothing; the value is taken
# literally to the end of the line, spaces included.
MEDIA_DIRS=/path/to/your/library

# Scan subfolders as well. Off by default because a deep tree can take a while
# to index; on is what you want for a library organised by show or year.
# Equivalent to passing -r on the command line.
#RECURSIVE=1

# --- everything else has a working default -----------------------------------

# HTTP + WebSocket port.
PORT=8090

# Required at /setup on the first run, when the admin account is created.
# Leave it unset and the server generates one per run and prints it at startup;
# set it here to keep the same token across restarts. Once an admin exists the
# route stops existing and this is unused.
#SETUP_TOKEN=change-me

# Where app.db and the transcode cache live. A bind mount in the container.
#DATA_DIR=./data

# Where converted files are kept. Defaults to DATA_DIR/transcoded. This is the
# largest thing the server writes, so on a machine with a small system disk
# (a Pi on an SD card, say) point it at an external drive.
#CACHE_DIR=./data/transcoded

# Disk budget for converted files. Oldest are evicted once the total passes it.
#TRANSCODE_CACHE_GB=20

# How many CPU threads transcoding may use in total, across every conversion
# running at once. Defaults to half the cores, which leaves the machine able to
# serve video while it encodes. Raise it on a dedicated box; drop it to 1 on a
# small one if playback stutters while a conversion is running.
#TRANSCODE_THREADS=2

# Signs session cookies. Generated and stored in the database on first run, so
# there is normally nothing to set here. Setting it lets you rotate
# deliberately: changing it signs everyone out.
#SERVER_SECRET=

# Set to 0 to close registration entirely. Even when open, registering needs an
# invite code and an admin's approval.
#ALLOW_REGISTRATION=1

# VERBOSE=1 logs every range request and room event. `npm run dev` does this
# without editing the file.
#VERBOSE=0
